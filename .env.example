# ==========================================
# RETELL AI CONFIGURATION
# ==========================================
RETELL_API_KEY=your_retell_api_key_here
RETELL_WEBHOOK_SECRET=your_retell_webhook_secret_here

# ==========================================
# ZOHO CRM OAUTH 2.0 CONFIGURATION
# ==========================================
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here

# Zoho Data Center URLs (Adjust to your region: .com, .eu, .in, .com.au, .ca)
# US: https://accounts.zoho.com and https://www.zohoapis.com
# EU: https://accounts.zoho.eu and https://www.zohoapis.eu
# IN: https://accounts.zoho.in and https://www.zohoapis.in
# AU: https://accounts.zoho.com.au and https://www.zohoapis.com.au
# CA: https://accounts.zoho.ca and https://www.zohoapis.ca
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# ==========================================
# APPLICATION & BUSINESS RULES CONFIGURATION
# ==========================================
APP_ENV=development
DEFAULT_PHONE_COUNTRY=NG
CREATE_LEADS_FOR_UNKNOWN_CALLERS=true
LEAD_SOURCE="AI Voice Agent"

# Diagnostic endpoint protection (required in production for /api/zoho/test)
DIAGNOSTIC_API_KEY=optional_secret_for_diagnostic_endpoint
